registry=https://registry.npmjs.org/
@iatec:registry=https://#{NPM_IATEC_HOST_COMMUNITY}#/npm/registry/

; Font Awesome Pro (licenciado) — o `@fortawesome/fontawesome-pro` do
; package.json NAO existe no npm publico. Sem estas duas linhas o
; `npm install` de TODOS os pipelines falha com 404 no pacote.
; A variavel FONTAWESOME_TOKEN precisa existir no grupo `nuget-credentials`.
@fortawesome:registry=https://npm.fontawesome.com/
//npm.fontawesome.com/:_authToken=#{FONTAWESOME_TOKEN}#

always-auth=true

; begin auth token
//#{NPM_IATEC_HOST_COMMUNITY}#/npm/registry/:username=#{NPM_Username}#
//#{NPM_IATEC_HOST_COMMUNITY}#/npm/registry/:_password=#{Base64_Password}#
//#{NPM_IATEC_HOST_COMMUNITY}#/npm/registry/:email=#{NPM_email}#
//#{NPM_IATEC_HOST_COMMUNITY}#/npm/:username=#{NPM_Username}#
//#{NPM_IATEC_HOST_COMMUNITY}#/npm/:_password=#{Base64_Password}#
//#{NPM_IATEC_HOST_COMMUNITY}#/npm/:email=#{NPM_email}#
; end auth token